{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build --workspace client -- --mode vercel",
  "outputDirectory": "client/dist",
  "functions": {
    "api/backend.js": {
      "includeFiles": "node_modules/{@napi-rs/canvas*,pdfjs-dist/standard_fonts}/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path+",
      "destination": "/api/backend?__resume_api_path=:path+"
    },
    {
      "source": "/:page(sign-in|resumes|jobs|compare|interviews|settings)",
      "destination": "/index.html"
    },
    {
      "source": "/interviews/:id",
      "destination": "/index.html"
    }
  ]
}
