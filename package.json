{
  "name": "resume-studio",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspace server",
    "seed:questions": "npm run seed:questions --workspace server"
  },
  "devDependencies": { "concurrently": "^9.2.1" }
}
